# Configuración compartida del editor.
# Compatible con VS Code, Android Studio / IntelliJ y la mayoría de editores.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 120

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
# Dos espacios al final fuerzan un salto de línea en Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
